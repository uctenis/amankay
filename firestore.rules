rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (
          request.auth.token.email == 'dsilvaroco@gmail.com'
          || (
            exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email))
            && get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email)).data.get('uid', request.auth.uid) == request.auth.uid
          )
        );
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'dsilvaroco@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /catalog/{productId} {
      // Catalog fields are public product information; keep stock and costs in /inventory.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inventory/{productId} {
      allow read, write: if isAdmin();
    }

    // Pedido enviado desde la tienda: cualquiera puede crearlo, pero solo como "Nuevo",
    // sin tocar stock ni pagos, y nadie fuera del panel puede leerlo ni modificarlo.
    function isWebOrder() {
      let order = request.resource.data;
      return order.keys().hasOnly(['number', 'customer', 'phone', 'email', 'region', 'city', 'address',
          'items', 'total', 'notes', 'status', 'channel', 'paid', 'stockDeducted', 'createdAt'])
        && order.status == 'Nuevo'
        && order.channel == 'Web'
        && order.paid == false
        && order.stockDeducted == false
        && order.createdAt == request.time
        && order.number is string && order.number.size() <= 24
        && order.customer is string && order.customer.size() > 0 && order.customer.size() <= 100
        && order.phone is string && order.phone.size() > 0 && order.phone.size() <= 30
        && order.email is string && order.email.size() <= 254
        && order.region is string && order.region.size() <= 40
        && order.city is string && order.city.size() <= 100
        && order.address is string && order.address.size() <= 200
        && order.notes is string && order.notes.size() <= 300
        && order.items is list && order.items.size() > 0 && order.items.size() <= 80
        && order.total is int && order.total >= 0 && order.total <= 50000000;
    }

    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (isWebOrder() && request.resource.data.number == orderId);
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /stockMovements/{movementId} {
      allow read, write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      // Only published testimonials are visible in the shop; drafts stay with admins.
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() || (
        exists(/databases/$(database)/documents/reviewInvites/$(testimonialId))
        && request.time < get(/databases/$(database)/documents/reviewInvites/$(testimonialId)).data.expiresAt
        && get(/databases/$(database)/documents/orders/$(get(/databases/$(database)/documents/reviewInvites/$(testimonialId)).data.orderId)).data.status == 'Entregado'
        && request.resource.data.keys().hasOnly(['name', 'city', 'productId', 'text', 'published', 'verifiedPurchase', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.city is string && request.resource.data.city.size() <= 100
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 400
        && request.resource.data.productId == get(/databases/$(database)/documents/reviewInvites/$(testimonialId)).data.productId
        && request.resource.data.published == false
        && request.resource.data.verifiedPurchase == true
        && request.resource.data.createdAt == request.time
      );
      allow update, delete: if isAdmin();
    }

    match /reviewInvites/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /adminUsers/{email} {
      allow get: if isOwner()
        || (
          request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email == email
        );
      allow list: if isOwner();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == email
        && resource.data.email == email
        && !('uid' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
      );
    }
  }
}
