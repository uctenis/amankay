rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'dsilvaroco@gmail.com'
          || (
            exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email))
            && get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email)).data.email == request.auth.token.email
          )
        );
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'dsilvaroco@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /catalog/{productId} {
      // Catalog fields are public product information; keep stock and costs in /inventory.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inventory/{productId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /stockMovements/{movementId} {
      allow read, write: if isAdmin();
    }

    match /adminUsers/{email} {
      allow get: if isOwner()
        || (
          request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == email
        );
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }
  }
}
